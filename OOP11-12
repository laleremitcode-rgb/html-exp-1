#include <iostream>
#include <vector>
using namespace std;

template <class T>
class Vector {
    vector<T> v;   // internal vector to store elements
public:
    // Function to create vector of given size
    void create(int n) {
        T val;
        cout << "Enter " << n << " elements: ";
        for (int i = 0; i < n; i++) {
            cin >> val;
            v.push_back(val);
        }
    }

    // Function to modify the value of a given element
    void modify(int index, T newValue) {
        if (index >= 0 && index < v.size()) {
            v[index] = newValue;
        } else {
            cout << "Invalid index!" << endl;
        }
    }

    // Function to multiply each element by a scalar value
    void multiply(T scalar) {
        for (int i = 0; i < v.size(); i++) {
            v[i] *= scalar;
        }
    }

    // Function to display the vector in (10,20,30,...) form
    void display() {
        cout << "(";
        for (int i = 0; i < v.size(); i++) {
            cout << v[i];
            if (i != v.size() - 1)
                cout << ", ";
        }
        cout << ")" << endl;
    }
};

// Main function
int main() {
    Vector<int> vec;   // can be any type (int, float, etc.)
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    vec.create(n);
    cout << "Original vector: ";
    vec.display();

    int index, newValue;
    cout << "Enter index and new value to modify: ";
    cin >> index >> newValue;
    vec.modify(index, newValue);
    cout << "After modification: ";
    vec.display();

    int scalar;
    cout << "Enter scalar value to multiply: ";
    cin >> scalar;
    vec.multiply(scalar);

    cout << "After multiplying by scalar: ";
    vec.display();

    return 0;
}
